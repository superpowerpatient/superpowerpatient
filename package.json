{
  "name": "igeonaeja-oneuldo",
  "version": "0.1.0",
  "description": "이겨내자 오늘도 — 항암 다이어리 PWA + 네이티브 앱 (iOS/Android via Capacitor)",
  "private": true,
  "scripts": {
    "build": "node ./scripts/build-www.mjs",
    "sync": "npm run build && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:android": "npm run sync && cap run android",
    "run:ios": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
